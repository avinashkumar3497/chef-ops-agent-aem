logging:
  receivers:
    aem-access:
      type: files
      include_paths:
        - /aem/author/crx-quickstart/logs/access.log ################################################
      record_log_file_path: true

    aem-error:
      type: files
      include_paths:
        - /aem/author/crx-quickstart/logs/error.log ################################################
      record_log_file_path: true

    aem-request:
      type: files
      include_paths:
        - /aem/author/crx-quickstart/logs/request.log ################################################
      record_log_file_path: true

  processors:
    aem-access-parser:
      type: parse_regex
      regex: '^(?<host>[^ ]*) [^ ]* (?<user>[^ ]*) (?<time>\d{2}/[A-Za-z]{3}/\d{4}:\d{2}:\d{2}:\d{2}) [^ ]* "(?<method>\S+)(?: +(?<path>(?:[^\"]|\\.)*?)(?: +\S*)?)?" (?<code>[^ ]*) (?<size>[^ ]*)(?: "(?<referer>(?:[^\"]|\\.)*)" "(?<agent>(?:[^\"]|\\.)*)")?$'

    multiline_parser:
      type: parse_multiline
      match_any:
        - type: language_exceptions
          language: java

    aem-error-parser:
      type: parse_regex
      regex: '^(?<time>\d{2}.\d{2}.\d{4} \d{2}:\d{2}:\d{2}\.\d{3}) \*(?<level>[^\s]+)\* (?<message>.*)'

    aem-request-parser:
      type: parse_regex
      regex: '^(?<time>\d{2}/[A-Za-z]{3}/\d{4}:\d{2}:\d{2}:\d{2}) [^ ]* \[(?<reqid>\d{1,500})\] (?<message>.*)'

    severity_parser:
        type: parse_severity
        field: level

  service:
    pipelines:
      aem-access-pipeline:
        receivers: [aem-access]
        processors: [aem-access-parser]

      aem-error-pipeline:
        receivers: [aem-error]
        processors:
            - multiline_parser
            - aem-error-parser
            - severity_parser

      aem-request-pipeline:
        receivers: [aem-request]
        processors: [aem-request-parser]
